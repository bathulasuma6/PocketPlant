<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data-extraction rules. Same exclusions as backup_rules.xml for both cloud backup
  and device-to-device transfer, so plant data and light history never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="pocketplant.db" />
        <exclude domain="database" path="pocketplant.db-journal" />
        <exclude domain="sharedpref" path="pocketplant_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="pocketplant.db" />
        <exclude domain="database" path="pocketplant.db-journal" />
        <exclude domain="sharedpref" path="pocketplant_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
